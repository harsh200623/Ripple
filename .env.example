# Copy to .env and fill in. Never commit .env.
# All variables are validated at startup by apps/api/src/config.ts.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL connection string (server-side only)
DATABASE_URL=postgres://ripple:ripple@localhost:5432/ripple

# GitHub token with read access to public repositories (server-side only)
GITHUB_TOKEN=

# Analysis limits
QUEUE_CONCURRENCY=2
ANALYSIS_TIMEOUT_MS=120000
MAX_CHANGED_FILES=300
MAX_ANALYSIS_FILES=20000
MAX_REPO_SIZE_MB=200
TEMP_DIR=/tmp/ripple

# Rate limit for POST /api/v1/analyses (requests per window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Set to "inline" to run the worker inside the API process (development only)
WORKER_MODE=inline
